# ZELLÉ Lead OS — environment template
# Copy to .env.local and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Safe to expose to the browser. NEXT_PUBLIC_* is inlined into the client
# bundle at build time. The anon key is designed for this: it carries no
# privileges of its own, and every request it makes is filtered by Row Level
# Security using the signed-in user's session.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# ---------------------------------------------------------------------------
# ⚠️  SERVER ONLY — never prefix with NEXT_PUBLIC_, never import into a Client
# Component. This key has the BYPASSRLS attribute: it reads and writes every
# organization's data with no policy checks at all. It is a master key to the
# entire database.
#
# Belongs in: Vercel server-side env vars, n8n credentials.
# Used by:    the ManyChat/n8n webhook route, admin operations such as changing
#             a user's role or moving them between organizations.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Shared secret n8n sends with each webhook call so the route can reject
# anything that is not from your workflow. Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=<random-secret>
